rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isYnovEmail() {
      return isSignedIn() && request.auth.token.email.matches('.*@ynov.com$');
    }

    match /users/{userId} {
      allow read, write: if isYnovEmail() && request.auth.uid == userId;
    }

    match /events/{eventId} {
      allow read: if isYnovEmail();
      allow write: if isYnovEmail();
    }

    match /clubs/{clubId} {
      allow read: if isYnovEmail();
      allow write: if isYnovEmail();
    }

    match /chatRooms/{roomId}/messages/{messageId} {
      allow read, write: if isYnovEmail();
    }
  }
}
